# Copy to .env and fill in.
ANTHROPIC_API_KEY=sk-ant-...

# Model used for the main agent loop (planning + tool calls).
MAIN_MODEL=anthropic:claude-sonnet-4-5-20250929

# Model used by writer tools (write_slide, write_report, build_page, ...).
WRITER_MODEL=anthropic:claude-sonnet-4-5-20250929

# Optional fallback model the resilience middleware switches to after
# repeated main-model failures. Leave unset to disable fallback.
FALLBACK_MODEL=

# Max retry attempts for a failed model call before giving up.
MODEL_MAX_RETRIES=2

# Directory the canvas store persists thread data under. Defaults to
# apps/server/canvas-data when unset.
CANVAS_DATA_DIR=

# Comma-separated origins allowed to call the SSE endpoint.
CORS_ORIGINS=http://localhost:3000
