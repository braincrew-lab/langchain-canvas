{
  "name": "@braincrew-lab/langchain-canvas",
  "version": "0.7.21",
  "description": "A live canvas for LangChain agents — stream documents, charts, and rich artifacts into a React panel.",
  "license": "MIT",
  "author": "Brain Crew (https://github.com/braincrew-lab)",
  "homepage": "https://github.com/braincrew-lab/langchain-canvas#readme",
  "type": "module",
  "keywords": [
    "langchain",
    "langgraph",
    "ai",
    "agent",
    "canvas",
    "artifacts",
    "generative-ui",
    "streaming",
    "llm",
    "react",
    "document",
    "chart",
    "spreadsheet",
    "slides"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/braincrew-lab/langchain-canvas.git",
    "directory": "packages/canvas-react"
  },
  "bugs": {
    "url": "https://github.com/braincrew-lab/langchain-canvas/issues"
  },
  "sideEffects": [
    "*.css",
    "./dist/index.js"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "comment": "Dev resolves to source (no build needed; Next transpiles via transpilePackages). publishConfig swaps to dist for npm.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/canvas.css",
    "./langgraph": "./src/langgraph/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./styles.css": "./dist/styles.css",
      "./langgraph": {
        "types": "./dist/langgraph/index.d.ts",
        "import": "./dist/langgraph/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build",
    "release:patch": "npm version patch -m \"release: %s\"",
    "release:minor": "npm version minor -m \"release: %s\"",
    "release:major": "npm version major -m \"release: %s\""
  },
  "peerDependencies": {
    "@langchain/langgraph-sdk": ">=0.0.70",
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "dependencies": {
    "@fortune-sheet/react": "^1.0.4",
    "@ungap/structured-clone": "1.3.0",
    "echarts": "^6.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.0",
    "zustand": "^4.5.4"
  },
  "optionalDependencies": {
    "docx": "^9.0.2",
    "docx-preview": "^0.4.0",
    "fast-formula-parser": "^1.0.19"
  },
  "devDependencies": {
    "@langchain/langgraph-sdk": "^1.9.28",
    "@types/react": "^19.0.0",
    "jsdom": "^25",
    "tsup": "^8.5.1",
    "typescript": "^5.5.4",
    "vite": "^8",
    "vitest": "^4"
  },
  "peerDependenciesMeta": {
    "@langchain/langgraph-sdk": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}
